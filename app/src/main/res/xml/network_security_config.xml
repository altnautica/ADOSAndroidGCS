<?xml version="1.0" encoding="utf-8"?>
<!--
    ADOS agents on the local network serve their API, MAVLink WebSocket and
    WHEP video over plain HTTP at a LAN address or a .local mDNS name. Neither
    can be enumerated as a domain list, so cleartext stays allowed for the app;
    requests are authenticated per node with its API key.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
