# Copy to local.properties and fill in. local.properties is gitignored, so a
# real endpoint or token never lands in the repository. Both keys are
# optional: an empty value builds an app with that feature switched off.
#
# Android SDK location (Android Studio writes this line for you).
# sdk.dir=/path/to/Android/Sdk
#
# Convex deployment URL used by the opt-in cloud features.
ados.convexUrl=https://example-deployment.convex.cloud
#
# Access token for a map tile provider that requires one. The default
# providers (OpenStreetMap, Esri World Imagery, OpenTopoMap) need none.
ados.mapToken=
