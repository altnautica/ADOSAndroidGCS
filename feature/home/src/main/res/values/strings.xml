    <!-- Safety disclaimer, accepted once per version before the app opens. -->
    <string name="disclaimer_title">Before you fly</string>
    <string name="disclaimer_subtitle">This app can control real aircraft. Read and accept the following.</string>
    <string name="disclaimer_lawful_heading">Lawful use only</string>
    <string name="disclaimer_lawful_body">You agree to use this software only for lawful purposes. You will not use it to conduct surveillance, harass individuals, violate privacy, or support any activity prohibited by law in your country or region.</string>
    <string name="disclaimer_military_heading">No unauthorised military use</string>
    <string name="disclaimer_military_body">This software must not be used for offensive military or defence operations without explicit authorisation from the relevant government authority. Unauthorised weaponisation of drones is illegal in virtually every jurisdiction.</string>
    <string name="disclaimer_aviation_heading">Aviation regulations</string>
    <string name="disclaimer_aviation_body">You alone are responsible for complying with every aviation regulation that applies to your location and operation, including registering your drone with the aviation authority, holding the pilot certificates or licences required, securing airspace authorisation before flight, and staying within altitude, distance and visual-line-of-sight limits. This software does not guarantee regulatory compliance. It is a tool. You are the pilot in command.</string>
    <string name="disclaimer_export_heading">Export controls</string>
    <string name="disclaimer_export_body">Drone control software may be subject to export control and sanctions laws in your country and others. You are responsible for making sure your use, distribution or modification of this software complies with them.</string>
    <string name="disclaimer_warranty_heading">No warranty and assumption of risk</string>
    <string name="disclaimer_warranty_body">This software is provided \"as is\", without warranty of any kind, express or implied, including merchantability, fitness for a particular purpose and non-infringement. Drones can cause property damage, injury or death if operated improperly or if software malfunctions. By using this software you assume all risk of its use; the authors and contributors are not liable for any claim, damage or loss arising from it.</string>
    <string name="disclaimer_license_heading">Open source licence</string>
    <string name="disclaimer_license_body">This app is licensed under the GNU General Public License v3.0. You are free to use, modify and distribute it under the terms of that licence. Settings › About › Open source licences lists the licence texts.</string>
    <string name="disclaimer_accept_check">I have read and accept the terms above. I understand that I am the pilot in command and responsible for safe and lawful operation.</string>
