<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: the fleet bench starts a phone bind over adb. -->
        <receiver
            android:name="com.altnautica.gcs.radio.rx.bench.BenchBindReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.altnautica.gcs.bench.BIND_DRONE" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: the fleet bench drives the phone's uplink over adb. -->
        <receiver
            android:name="com.altnautica.gcs.radio.rx.bench.BenchLinkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.altnautica.gcs.bench.PARAM_READ" />
                <action android:name="com.altnautica.gcs.bench.PARAM_SET" />
                <action android:name="com.altnautica.gcs.bench.MISSION_UPLOAD" />
                <action android:name="com.altnautica.gcs.bench.RELAY_CALL" />
                <action android:name="com.altnautica.gcs.bench.CONFIG_GET" />
                <action android:name="com.altnautica.gcs.bench.CONFIG_PUT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
