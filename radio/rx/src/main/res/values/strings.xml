    <string name="phone_radio_dongle_none_message">Plug an RTL8812EU or RTL8812AU USB radio into this phone with a USB OTG adapter. A powered hub keeps the radio stable.</string>
    <string name="phone_radio_dongle_unsupported">This radio (0bda:%1$04x) is an RTL8812BU, a different chipset that cannot be used. Use an RTL8812EU or RTL8812AU radio.</string>
